# Environment Configuration
# Copy this file to .env and fill in your actual API keys
# This file is safe to commit (no secrets)

# ==========================================
# OpenRouter API Key (Required for LLM)
# Get from: https://openrouter.ai
# Free tier available for testing
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==========================================
# Langfuse (Optional - for observability)
# Get from: https://langfuse.com
# Not required for basic functionality
# ==========================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ==========================================
# Notes:
# - Without OPENROUTER_API_KEY: Agent uses rule-based mode (no LLM)
# - Without Langfuse keys: Agent works, no tracing
# - All environment variables are optional for basic functionality
# ==========================================
